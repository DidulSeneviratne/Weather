<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:padding="8dp"
    android:background="@drawable/button_etutor_design"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/imageview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginRight="10dp"
        android:src="@drawable/red1" />

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_toEndOf="@id/imageview"
        android:textColor="@color/white"
        android:textSize="20dp"
        tools:text="Name" />

    <TableLayout
        android:id="@+id/tab1"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/name"
        android:layout_toEndOf="@id/imageview"
        android:background="@drawable/button_etutor_design">

        <!-- Table Heading -->

        <TableRow>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="3sp"
                android:text="CO"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/co"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center_horizontal"
                android:padding="3sp"
                android:text="rname"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

        </TableRow>

        <TableRow>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="3sp"
                android:text="NO"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/NO"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center_horizontal"
                android:padding="3sp"
                android:text="rname"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

        </TableRow>

        <TableRow>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="3sp"
                android:text="NO2"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/NO2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center_horizontal"
                android:padding="3sp"
                android:text="NO@"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

        </TableRow>


    </TableLayout>


    <TableLayout
        android:id="@+id/tab23"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/name"
        android:layout_marginStart="00dp"
        android:layout_marginTop="0dp"
        android:layout_toEndOf="@+id/tab1"
        android:background="@drawable/button_etutor_design">

        <!-- Table Heading -->

        <TableRow>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="3sp"
                android:text="O3"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/O3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center_horizontal"
                android:padding="3sp"
                android:text="rname"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

        </TableRow>

        <TableRow>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="3sp"
                android:text="S02"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/S02"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center_horizontal"
                android:padding="3sp"
                android:text="rname"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

        </TableRow>

        <TableRow>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="3sp"
                android:text="nh3"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/nh3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:fontFamily="sans-serif-smallcaps"
                android:gravity="center_horizontal"
                android:padding="3sp"
                android:text="rname"
                android:textColor="@color/white"
                android:textFontWeight="900"
                android:textSize="15sp" />

        </TableRow>


    </TableLayout>


</RelativeLayout>